<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="470.0" prefWidth="740.0" styleClass="login-root"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.init">
    <stylesheets>
        <URL value="@/style/main.css"/>
    </stylesheets>

    <!-- ============ 左侧：品牌 + 已保存连接 ============ -->
    <VBox prefWidth="255.0" styleClass="brand-panel">
        <padding>
            <Insets bottom="20.0" left="22.0" right="22.0" top="34.0"/>
        </padding>
        <children>
            <ImageView fitHeight="64.0" fitWidth="64.0" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@../images/ico.png"/>
                </image>
            </ImageView>
            <Label styleClass="brand-title" text="TURACOS"/>
            <Label styleClass="brand-sub" text="数据库安全评估工具"/>
            <Label styleClass="saved-title" text="已保存的连接"/>
            <StackPane VBox.vgrow="ALWAYS" minHeight="150.0">
                <ListView fx:id="savedConfigsList" minHeight="150.0" prefHeight="230.0"
                          styleClass="saved-list">
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ListView>
                <Label fx:id="savedEmptyLabel" alignment="CENTER" mouseTransparent="true"
                       styleClass="saved-empty"
                       text="暂无已保存的配置&#10;连接成功后自动出现在这里"/>
            </StackPane>
            <Label styleClass="brand-version" text="V1.4.5 · 本地审计留痕已开启"/>
        </children>
    </VBox>

    <!-- ============ 右侧：连接表单 ============ -->
    <VBox alignment="TOP_LEFT" maxWidth="485.0" prefWidth="485.0" spacing="10"
          styleClass="form-panel">
        <padding>
            <Insets bottom="20.0" left="34.0" right="34.0" top="26.0"/>
        </padding>
        <children>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="form-title" text="新建数据库连接"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="themeButton" mnemonicParsing="false" onAction="#onToggleTheme"
                        styleClass="theme-toggle" text="深色">
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </Button>
            </HBox>
            <Label styleClass="form-sub" text="填写目标数据库连接信息，双击左侧配置可快速连接"/>

            <!-- 类型 -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="form-row">
                <Label prefWidth="86.0" styleClass="form-label" text="数据库类型"/>
                <ComboBox fx:id="ComboBox" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="form-input">
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ComboBox>
            </HBox>
            <!-- 地址 -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="form-row">
                <Label prefWidth="86.0" styleClass="form-label" text="数据库地址"/>
                <TextField fx:id="hostTextField" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                           promptText="127.0.0.1" styleClass="form-input"/>
            </HBox>
            <!-- 用户名 -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="form-row">
                <Label prefWidth="86.0" styleClass="form-label" text="连接用户名"/>
                <TextField fx:id="usernameTextField" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                           promptText="root" styleClass="form-input"/>
            </HBox>
            <!-- 密码 -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="form-row">
                <Label prefWidth="86.0" styleClass="form-label" text="连接密码"/>
                <TextField fx:id="passwordPlainTextField" managed="false" visible="false"
                           HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="form-input"/>
                <PasswordField fx:id="passwordTextField" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                               styleClass="form-input"/>
                <ImageView fx:id="togglePasswordImage" fitHeight="17.0" fitWidth="17.0"
                           onMouseClicked="#onTogglePasswordVisibility" pickOnBounds="true"
                           preserveRatio="true">
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ImageView>
            </HBox>
            <!-- 端口 -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="form-row">
                <Label prefWidth="86.0" styleClass="form-label" text="端口"/>
                <TextField fx:id="portTextField" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                           promptText="3306" styleClass="form-input"/>
            </HBox>
            <!-- 数据库 -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="form-row">
                <Label prefWidth="86.0" styleClass="form-label" text="数据库"/>
                <TextField fx:id="databaseTextField" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                           promptText="mysql" styleClass="form-input"/>
            </HBox>

            <!-- 操作按钮：紧跟表单下方 -->
            <HBox alignment="CENTER_RIGHT" spacing="12" maxWidth="Infinity"
                  styleClass="form-actions">
                <Button mnemonicParsing="false" onAction="#onTestconnection"
                        styleClass="ghost-button" text="测试连接">
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </Button>
                <Button fx:id="loginButton" mnemonicParsing="false" onAction="#onComboBoxChanged"
                        styleClass="primary-button" text="保存并打开">
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </Button>
            </HBox>
        </children>
    </VBox>
</HBox>
