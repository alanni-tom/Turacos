                                            </children>
                                        </AnchorPane>
                                    </content>
                                </Tab>

                                <!-- MSSQL 专用标签 -->
                                <Tab text="MSSQL">
                                    <content>
                                        <AnchorPane>
                                            <children>
                                                <VBox alignment="CENTER" spacing="15" styleClass="psql-pane"
                                                      AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                                                      AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

                                                    <!-- ============ 第一部分：命令执行 ============ -->
