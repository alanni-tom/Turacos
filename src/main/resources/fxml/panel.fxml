<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<AnchorPane fx:id="rootPane" prefHeight="640.0" prefWidth="980.0" stylesheets="@/style/panel.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.panel">
    <children>
        <!-- 整体：顶栏 + 主体 -->
        <VBox styleClass="app-root" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- 顶部工具条 -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="app-header">
                    <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@/images/ico.png"/>
                        </image>
                    </ImageView>
                    <VBox alignment="CENTER_LEFT" spacing="1">
                        <Label styleClass="app-brand" text="TURACOS"/>
                        <Label styleClass="app-subtitle" text="数据库安全评估工具"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="complianceHintLabel" styleClass="app-hint" text=""/>
                    <Button onAction="#runComplianceCheck" styleClass="psql-button" text="合规基线检查"/>
                    <Button fx:id="themeButton" mnemonicParsing="false" onAction="#onToggleTheme"
                            styleClass="theme-toggle" text="深色">
                        <cursor>
                            <Cursor fx:constant="HAND"/>
                        </cursor>
                    </Button>
                </HBox>

                <!-- 主体分割 -->
                <SplitPane dividerPositions="0.22" styleClass="main-split" VBox.vgrow="ALWAYS">
                    <items>
                        <!-- 左侧数据库列表 -->
                        <VBox prefWidth="200.0" styleClass="side-panel">
                            <children>
                                <TreeView fx:id="treeView" prefHeight="560.0" prefWidth="210.0"
                                          styleClass="db-tree"/>
                            </children>
                        </VBox>
                <!-- 右侧主工作区 -->
                <VBox>

                    <!-- 标签化功能区 + 日志输出 -->
                    <SplitPane dividerPositions="0.7" orientation="VERTICAL" styleClass="main-split">
                        <items>
                            <!-- 上半部分：TabPane 功能区 -->
                            <TabPane fx:id="rightTabPane" tabClosingPolicy="UNAVAILABLE">

                                <!-- 第一个 Tab：数据库表内容 -->
                                <Tab text="数据库表">
                                    <VBox spacing="5.0" style="-fx-padding:5;">
                                        <TableView fx:id="tableView" prefHeight="400.0"
                                                   maxWidth="Infinity" maxHeight="Infinity"
                                                   VBox.vgrow="ALWAYS"/>
                                    </VBox>
                                </Tab>


                                <!-- 第二个 Tab：执行 SQL -->
                                <Tab text="执行 SQL">
                                    <VBox spacing="5.0" style="-fx-padding:5;">
                                        <TextArea fx:id="sqlTextArea" prefHeight="351.0"
                                                  maxWidth="Infinity" maxHeight="Infinity"
                                                  styleClass="sql-text-area" wrapText="true"
                                                  VBox.vgrow="ALWAYS"/>
                                        <Button onAction="#btnExecuteSql" maxWidth="Infinity"
                                                prefHeight="23.0" text="执行 SQL"/>
                                    </VBox>
                                </Tab>

                                <!-- PSQL 专用标签 -->
                                <Tab text="PSQL">
                                    <content>
                                        <AnchorPane>
                                            <children>
                                                <VBox alignment="CENTER" spacing="15" styleClass="psql-pane"
                                                      AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                                                      AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

                                                    <!-- ============ 第一部分：命令执行 ============ -->
                                                    <VBox alignment="CENTER_LEFT" spacing="8" styleClass="psql-section">
                                                        <Label styleClass="psql-section-title" text="命令执行">
                                                            <graphic>
                                                                <ImageView fitHeight="16" fitWidth="16"
                                                                           preserveRatio="true" smooth="true">
                                                                    <image>
                                                                        <Image url="@/images/cmd.png"/>
                                                                    </image>
                                                                </ImageView>
                                                            </graphic>
                                                        </Label>
                                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                                            <Label styleClass="psql-label" text="方式:"/>
                                                            <ChoiceBox fx:id="execChoiceBox" prefWidth="140.0"
                                                                       styleClass="psql-choicebox">
                                                                <cursor>
                                                                    <Cursor fx:constant="HAND"/>
                                                                </cursor>
                                                            </ChoiceBox>
                                                            <Label styleClass="psql-label" text="命令:"/>
                                                            <TextField fx:id="commandField" prefWidth="250.0"
                                                                       promptText="whoami" styleClass="psql-textfield"/>
                                                            <Button onAction="#executeCmdButton"
                                                                    styleClass="psql-button" text="执行"/>
                                                        </HBox>
                                                    </VBox>

                                                    <!-- ============ 第二部分：文件读取 ============ -->
                                                    <VBox alignment="CENTER_LEFT" spacing="8" styleClass="psql-section">
                                                        <Label styleClass="psql-section-title" text="文件读取">
                                                            <graphic>
                                                                <ImageView fitHeight="16" fitWidth="16"
                                                                           preserveRatio="true" smooth="true">
                                                                    <image>
                                                                        <Image url="@/images/file.png"/>
                                                                    </image>
                                                                </ImageView>
                                                            </graphic>
                                                        </Label>
                                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                                            <Label styleClass="psql-label" text="方式:"/>
                                                            <ChoiceBox fx:id="fileChoiceBox" prefWidth="140.0"
                                                                       styleClass="psql-choicebox">
                                                                <cursor>
                                                                    <Cursor fx:constant="HAND"/>
                                                                </cursor>
                                                            </ChoiceBox>
                                                            <Label styleClass="psql-label" text="路径:"/>
                                                            <TextField fx:id="filePathField" prefWidth="250.0"
                                                                       promptText="/etc/passwd"
                                                                       styleClass="psql-textfield"/>
                                                            <Button onAction="#readFileButton" styleClass="psql-button"
                                                                    text="读取"/>
                                                        </HBox>
                                                    </VBox>

                                                    <!-- ============ 第三部分：反弹 Shell ============ -->
                                                    <VBox alignment="CENTER_LEFT" spacing="8" styleClass="psql-section">
                                                        <Label text="反弹 Shell" styleClass="psql-section-title">
                                                            <graphic>
                                                                <ImageView fitHeight="16" fitWidth="16"
                                                                           preserveRatio="true" smooth="true">
                                                                    <image>
                                                                        <Image url="@/images/results.png"/>
                                                                    </image>
                                                                </ImageView>
                                                            </graphic>
                                                        </Label>
                                                        <HBox spacing="10" alignment="CENTER_LEFT">
                                                            <Label text="VPS IP:" styleClass="psql-label"/>
                                                            <TextField fx:id="reverseHost" promptText="127.0.0.1"
                                                                       prefWidth="250.0" styleClass="psql-textfield"/>
                                                            <Label text="VPS Port:" styleClass="psql-label"/>
                                                            <TextField fx:id="reversePort" promptText="4444"
                                                                       prefWidth="105.0" styleClass="psql-textfield"/>
                                                            <Button text="Doit!" onAction="#reverseShell"
                                                                    styleClass="psql-button"/>
                                                        </HBox>
                                                    </VBox>


                                                </VBox>
                                            </children>
                                        </AnchorPane>
                                    </content>
                                </Tab>

                                <!--MySQL专用标签-->
                                <Tab text="MySQL">
                                    <content>
                                        <AnchorPane>
                                            <children>
                                                <VBox alignment="CENTER" spacing="15" styleClass="psql-pane"
